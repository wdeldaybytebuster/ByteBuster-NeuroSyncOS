# .understandignore - patterns for files/dirs to exclude from analysis
# Syntax: same as .gitignore (globs, # comments, ! negation, trailing / for dirs)
#
# Keep source, docs, scripts, and tests visible to Understand Anything.
# Exclude local secrets, runtime state, generated output, and analyzer scratch data.

# --- Secrets and local credentials ---
.env
.env.*
!.env.example
cookies.txt
cookies2.txt
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_ed25519
*.sqlite
*.sqlite3

# --- Local runtime data ---
.data/
*.db
*.db-shm
*.db-wal
*.db-journal

# --- Generated/cache directories ---
.gitnexus/
.understand-anything/
.understand-anything/.trash-*/
.understand-anything/tmp/
node_modules/
dist/
build/
coverage/
.vite/
.cache/
.turbo/

# --- Logs and temporary files ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
*.tmp
*.temp
*.tsbuildinfo
.DS_Store
Thumbs.db
*.swp
*.swo
*~

{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NeuroSync",
  "version": "1.0.0",
  "identifier": "com.neurosync.app",
  "build": {
    "frontendDist": "../dist/ui",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "NeuroSync Sovereign OS",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/sidecar"
    ],
    "resources": {
      "bin/**/*": ""
    }
  }
}

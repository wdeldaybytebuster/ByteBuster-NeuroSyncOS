# Dependencies
node_modules/

# Environment & secrets
.env
.env.*
cookies.txt
cookies2.txt

# GitNexus
.gitnexus/

# Antigravity (contains local MCP tokens)
.antigravity/

# Understand-Anything (local analysis cache)
.understand-anything/

# Build output
dist/

# Worker thread bundles, regenerated at process boot by esbuild (see the
# worker-pool.ts generators under core/coreexec and core/memory/cerebro).
# Glob covers EVERY generator location and enforces the "No Transient Artifact
# Edits" rule — never commit or edit *.generated.cjs.
*.generated.cjs

# Data files (SQLite)
.data/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*

# Cache
.cache/
*.tsbuildinfo

# Local models (GGUF files are multi-GB)
local_models/
*.gguf

# Database backups
backup-*.db
backup-*.db-journal

# Python fix scripts (dev-only)
src/ui/*.py

# Error logs
ts-errors.txt

# Tauri Binaries and generated bundle resources
src-tauri/binaries/
src-tauri/resources/

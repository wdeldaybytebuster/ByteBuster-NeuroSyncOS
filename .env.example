# NeuroSync Local API Gateway — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─── LLM Provider ────────────────────────────────────────────────────────────
# The base URL of any OpenAI-compatible API endpoint.
# Examples:
#   OpenRouter:     https://openrouter.ai/api
#   FreeLLMAPI:     http://localhost:11434   (Ollama-style local proxy)
#   OpenCodeZen:    https://api.opencodezen.com
#   Custom proxy:   http://localhost:8080
NEUROSYNC_LLM_BASE_URL=

# Your API key (optional — only required if the endpoint checks Authorization)
NEUROSYNC_LLM_API_KEY=

# Model ID to use. Set to 'auto' to let FreeLLMAPI or the proxy choose dynamically.
# Examples: gpt-4o-mini, claude-3-haiku, mistral-7b-instruct, auto
NEUROSYNC_LLM_MODEL=auto

# ─── Server ───────────────────────────────────────────────────────────────────
# Default port for the Hono backend (frontend expects 3743)
NEUROSYNC_PORT=3743
